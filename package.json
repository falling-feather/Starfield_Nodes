{
  "name": "starfield-nodes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/typescript-loader.mjs --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview",
    "bench:batch": "node scripts/bench-batch.mjs",
    "bench:check": "node scripts/bench-check.mjs",
    "bench:analyze": "node scripts/bench-analyze.mjs",
    "package": "npm run build && pwsh -NoProfile -File scripts/package-release.ps1"
  },
  "devDependencies": {
    "playwright": "^1.59.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.4"
  }
}
